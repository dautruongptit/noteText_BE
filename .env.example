# Copy file nay thanh .env va dien gia tri that, KHONG commit .env vao git

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Sinh bang: openssl rand -base64 32
JWT_SECRET= SuperLongSecretKeyHereAtLeast32CharactersMakeItRandom2026

# Sinh bang: openssl rand -base64 32  (dung cho AES-256-GCM)
CRYPTO_SECRET_KEY=

# Backend chay port 8085 (cau hinh qua SERVER_PORT, xem docker-compose.yml)

# ---- CORS + redirect sau khi dang nhap Google ----
# Co 2 kich ban trien khai, chon dung 1 gia tri khop thuc te:
#
# (A) Dev local, chay `pnpm dev` truc tiep (khong qua Docker/nginx):
#     FRONTEND_REDIRECT_URL=http://localhost:5175/oauth/callback
#     ALLOWED_ORIGINS=http://localhost:5175
#
# (B) Docker + nginx reverse proxy (xem repo frontend noteText, nginx port 85):
#     nginx la nguoi DUY NHAT trinh duyet noi chuyen truc tiep, nen ORIGIN
#     that su la port 85, khong phai 5175/8085 nua:
#     FRONTEND_REDIRECT_URL=http://localhost:85/oauth/callback
#     ALLOWED_ORIGINS=http://localhost:85
FRONTEND_REDIRECT_URL=http://localhost:5175/oauth/callback
ALLOWED_ORIGINS=http://localhost:5175

STORAGE_BASE_PATH=/data/noted/notes

# So ngay giu lai note da xoa (soft-delete) truoc khi bi XOA VINH VIEN
# (purge job, SEC-12) - het moc nay khong con kha nang khoi phuc
NOTES_PURGE_AFTER_DAYS=30

# Gioi han goi PATCH /api/notes/{id}/content (auto-save, SEC-13) - THEO USER.
# Mac dinh 5 request bung + 1 token moi 500ms la du rong rai cho FE (debounce
# 1.3s), chi chan duoc client loi/spam qua nhanh
RATE_LIMIT_AUTOSAVE_CAPACITY=5
RATE_LIMIT_AUTOSAVE_REFILL_MS=500

# false khi dev local (http), true khi production qua https
REFRESH_COOKIE_SECURE=false

# ---- Luong ket noi Google Drive (SEC-09) ----
# PHAI khop chinh xac voi "Authorized redirect URIs" da khai bao trong
# Google Cloud Console, neu khong Google se tra loi "redirect_uri_mismatch"
DRIVE_REDIRECT_URI=http://localhost:8085/api/drive/callback
DRIVE_FRONTEND_CALLBACK_URL=http://localhost:5175/drive/callback
